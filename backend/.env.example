# Optional. You can also use the root .env.local or export these in the shell.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated origins, e.g. http://localhost:3000,http://127.0.0.1:3000
ANALOG_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional feature-table overlay built by the prepare CLI. Relative to startup directory.
ANALOG_FEATURE_OVERLAY=
# Optional local frozen sentence-transformer directory. Install requirements-semantic.txt.
ANALOG_EMBEDDING_MODEL=
# Optional prepared regional search grid. The packaged grid is used by default.
ANALOG_SEARCH_GRID=
# Optional Copernicus terrain patches prepared for the selected Earth grid.
ANALOG_TERRAIN_PATCHES=
